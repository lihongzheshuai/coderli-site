# ==============================================================================
# OneCoder 博客环境变量配置文件范例 (.env.example)
# 使用方法：复制本文件为 .env.local 并填入实际值：cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 自建数据库连接串 (DATABASE_URL)
# 系统已内置兼容驱动：支持 PostgreSQL (推荐) 与 MySQL。
# 若留空或未配置，系统会自动开启本地文件容错模式 (.db_data/)，保证零配置开箱可用。
#
# 方案 A (推荐)：云托管 PostgreSQL (如 Supabase / Neon / AWS RDS)
# - Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# - Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
#
# 方案 B：自建 VPS Docker PostgreSQL (使用项目根目录下的 docker-compose.db.yml)
# - DATABASE_URL="postgresql://onecoder:onecoder_secure_password@your-vps-ip:5432/coderli_blog"
#
# 方案 C：自建 MySQL 8.0+
# - DATABASE_URL="mysql://root:password@your-vps-ip:3306/coderli_blog"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://onecoder:onecoder_secure_password@localhost:5432/coderli_blog"

# ------------------------------------------------------------------------------
# 2. Vercel On-Demand ISR 按需刷新密钥与管理员口令 (REVALIDATE_SECRET / ADMIN_SECRET)
# - REVALIDATE_SECRET: 当发表或修改文章时，调用 /api/revalidate 局部刷新缓存
# - ADMIN_SECRET: 管理员安全口令，用于邮件内「一键删除留言」的防伪加密签名校验
# (若未单独配置 ADMIN_SECRET，系统将自动复用 REVALIDATE_SECRET)
# ------------------------------------------------------------------------------
REVALIDATE_SECRET="onecoder-secret-token-change-in-production"
ADMIN_SECRET="onecoder-secret-token-change-in-production"

# ------------------------------------------------------------------------------
# 3. 站点根域名 (用于 SEO Canonical 标签、OpenGraph、RSS 订阅链接及邮件内文章链接)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.coderli.com"

# ------------------------------------------------------------------------------
# 4. 读者留言邮件通知 (Email Notification on Comments)
# 当有读者在文章下方留言时，系统将自动向站长邮箱发送提醒邮件，包含文章标题、地址及留言全文。
# ------------------------------------------------------------------------------
# 站长接收提醒的邮箱地址 (默认为 wushikezuo@gmail.com)
COMMENT_NOTIFICATION_EMAIL="wushikezuo@gmail.com"

# ==============================================================================
# 方案 A (Vercel 部署首选推荐): Resend 云端邮件服务
# ==============================================================================
# 优势：
#   1. 完全通过 HTTPS REST API 发送，在 Vercel Serverless Function 极速发送（<100ms）。
#   2. 不受任何云服务商出站 TCP 端口（如 25/465/587）限制，零握手超时风险。
#   3. 免费额度每天 100 封，足够个人博客使用。
# 步骤：
#   1. 访问 https://resend.com 免费注册登录
#   2. 在 API Keys 中创建并复制以 re_ 开头的密钥
#   3. 在 Vercel 项目控制台 -> Settings -> Environment Variables 添加 RESEND_API_KEY 即可
# RESEND_API_KEY="re_1234567890abcdef"
# RESEND_FROM="OneCoder Blog <onboarding@resend.dev>"

# ==============================================================================
# 方案 B: 标准 SMTP 方式 (支持 QQ 邮箱 / 163 邮箱 / Gmail / 企业邮箱 / VPS 自建)
# ==============================================================================
# 提示：若在 Vercel 部署使用 SMTP，建议使用端口 465 (SSL) 或 587 (TLS)。
#
# 示例 1: QQ 邮箱
#   - SMTP_HOST="smtp.qq.com"
#   - SMTP_PORT=465
#   - SMTP_SECURE=true
#   - SMTP_USER="your_qq_number@qq.com"
#   - SMTP_PASS="填入QQ邮箱设置->账户中生成的16位授权码(非QQ密码)"
#   - SMTP_FROM="\"OneCoder 博客\" <your_qq_number@qq.com>"
#
# 示例 2: 163 邮箱
#   - SMTP_HOST="smtp.163.com"
#   - SMTP_PORT=465
#   - SMTP_SECURE=true
#   - SMTP_USER="your_name@163.com"
#   - SMTP_PASS="填入163邮箱POP3/SMTP服务生成的授权密码"
#   - SMTP_FROM="\"OneCoder 博客\" <your_name@163.com>"
#
# 示例 3: Gmail (需开启 Google 账号两步验证并创建「应用专用密码」App Password)
#   - SMTP_HOST="smtp.gmail.com"
#   - SMTP_PORT=465
#   - SMTP_SECURE=true
#   - SMTP_USER="your_gmail@gmail.com"
#   - SMTP_PASS="填入16位Google应用专用密码"
#   - SMTP_FROM="\"OneCoder 博客\" <your_gmail@gmail.com>"
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"OneCoder 博客\" <your_email@example.com>"
