# ==============================================================================
# OneCoder 博客环境变量配置文件范例 (.env.example)
# 使用方法：复制本文件为 .env.local 并填入实际值：cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 自建数据库连接串 (DATABASE_URL)
# 系统已内置兼容驱动：支持 PostgreSQL (推荐) 与 MySQL。
# 若留空或未配置，系统会自动开启本地文件容错模式 (.db_data/)，保证零配置开箱可用。
#
# 方案 A (推荐)：云托管 PostgreSQL (如 Supabase / Neon / AWS RDS)
# - Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# - Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
#
# 方案 B：自建 VPS Docker PostgreSQL (使用项目根目录下的 docker-compose.db.yml)
# - DATABASE_URL="postgresql://onecoder:onecoder_secure_password@your-vps-ip:5432/coderli_blog"
#
# 方案 C：自建 MySQL 8.0+
# - DATABASE_URL="mysql://root:password@your-vps-ip:3306/coderli_blog"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://onecoder:onecoder_secure_password@localhost:5432/coderli_blog"

# ------------------------------------------------------------------------------
# 2. Vercel On-Demand ISR 按需刷新密钥 (REVALIDATE_SECRET)
# 当发表或修改文章时，可调用 /api/revalidate 局部刷新指定页面与首页静态缓存（耗时约 300ms）
# 示例请求: POST /api/revalidate?secret=YOUR_TOKEN&slug=gesp-3-luogu-p2089
# ------------------------------------------------------------------------------
REVALIDATE_SECRET="onecoder-secret-token-change-in-production"

# ------------------------------------------------------------------------------
# 3. 站点根域名 (用于 SEO Canonical 标签、OpenGraph 及 RSS 订阅链接)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.coderli.com"
